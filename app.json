{
  "expo": {
    "name": "UniwindRepro",
    "slug": "uniwind-frozen-swap-repro",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.repro.uniwindfrozenswap"
    },
    "android": {
      "package": "com.repro.uniwindfrozenswap"
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Aeonik-Regular.ttf",
            "./assets/fonts/Aeonik-Light.ttf",
            "./assets/fonts/Aeonik-Bold.ttf"
          ]
        }
      ]
    ]
  }
}
